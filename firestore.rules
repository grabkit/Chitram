rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidMovie(data) {
      return data.keys().hasAll(['title', 'year', 'posterUrl']) &&
             data.title is string && data.title.size() <= 200 &&
             data.year is number &&
             data.posterUrl is string;
    }

    // Global Public Movies Collection - anyone in the world can read
    match /movies/{movieId} {
      allow read, get, list: if true;
      allow create: if isValidId(movieId) && isValidMovie(request.resource.data);
      allow update: if isValidId(movieId) && isValidMovie(request.resource.data);
      allow delete: if isValidId(movieId);
    }

    // Default catch-all
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
